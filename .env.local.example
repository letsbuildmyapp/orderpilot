# Frontend Firebase config (browser-safe). Copy to .env.local and fill in.
# When unset AND running `npm run dev`, the app auto-connects to the local
# Firebase emulator suite (see src/lib/firebase.ts).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Force emulator in any mode
VITE_USE_EMULATOR=true

# --- Server-only secrets (do NOT prefix with VITE_) ---
# These are read by Cloud Functions, never bundled to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
LLM_API_KEY=
